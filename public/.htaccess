# BEGIN Block WordPress xmlrpc.php requests (protege /latoma)
<Files "xmlrpc.php">
order deny,allow
deny from all
allow from 127.0.0.1
</Files>
# END Block WordPress xmlrpc.php requests

# BEGIN Restrict good Web Crawlers a franja horaria — SOLO latoma.com.ar.
# El sitio de SISE es estático (servirlo no cuesta nada) y en plena migración
# Google necesita recorrerlo sin límite para digerir las redirecciones.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?latoma\.com\.ar$ [NC]
RewriteCond %{TIME_HOUR}%{TIME_MIN} <2000
RewriteCond %{TIME_HOUR}%{TIME_MIN} >0200
RewriteCond %{HTTP_USER_AGENT} ^.*(Googlebot|Bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot|Bytespider|Twitterbot|LinkedInBot|FacebookBot|meta-externalagent|meta-webindexer|Applebot).*$ [NC]
RewriteRule .* - [R=503,L]
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?latoma\.com\.ar$ [NC]
RewriteCond %{TIME_HOUR}%{TIME_MIN} <0200 [OR]
RewriteCond %{TIME_HOUR}%{TIME_MIN} >0800
RewriteCond %{HTTP_USER_AGENT} ^.*(Sogou|Exabot|Amazonbot|GPTBot|PerplexityBot|ClaudeBot|OAI-SearchBot|meta-externalads|TerraCotta).*$ [NC]
RewriteRule .* - [R=503,L]
</IfModule>
# END Restrict good Web Crawlers

# BEGIN Block Tools and Libraries/User-Agent
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_USER_AGENT} ^.*(sqlmap|WPScan|JoomlaScan|i9scan|TBI-HttpOpenPlugin|TBI-WebScanner|lkxscan|Lkx-TraversalHttpPlugin|Acunetix|CensysInspect|Nmap|FHscan|HTTrack|libwww-perl|urllib|python-requests|python-httplib2|python-httpx|winhttp|lwp-request|lwp-trivial|fasthttp|Go-http-client|Java|httplib|httpclient|Zend_Http_Client|Apache-HttpClient|Custom-AsyncHttpClient|aiohttp|GRequests|exploit-script|paloaltonetworks.com|Scrapy|Mechanize|GenomeCrawlerd|FastScan).*$ [NC]
RewriteRule .* - [R=503,L]
</IfModule>
# END Block Tools and Libraries/User-Agent

# BEGIN Block bad User-Agent
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_USER_AGENT} ^.*(SemrushBot|AhrefsBot|Barkrowler|UCBrowser|MQQBrowser|LieBaoFast|Mb2345Browser|serpstatbot|Linguee|PetalBot|Seekport|SeekportBot|DotBot|trendictionbot|DataForSeoBot|Semanticbot|Buck|ips-agent|GeedoBot|MJ12bot|GrapeshotCrawler|heritrix|OpenindexSpider|MetadataScraper|Verity|proximic|AwarioBot|Paqlebot|SentiBot|Friendly_Crawler|BLEXBot|GeedoProductSearch|ByteSpider|Bytedance|MuckRack|ImagesiftBot|CCBot|cortex|wine-searcherbot|VelenPublicWebCrawler|Qwantbot|iaskspider|Timpibot|BacklinksExtendedBot|Mediatoolkitbot|MixrankBot|Team\ Anon\ Force|TheSafeInternetSearch|Owler|crawler_eb_germany_2\.0|GoogleOther|KrebsOnSecurity|ias_crawler|UP\.Link|panscient\.com|newsai|IbouBot|ModatScanner|cypex\.ai|Turnitin|SERankingBacklinksBot|MojeekBot).*$ [NC]
RewriteRule .* - [R=503,L]
</IfModule>
# END Block bad User-Agent

# Enrutamiento para latoma.com.ar (SIN redirección visible)
<IfModule mod_rewrite.c>
RewriteEngine On

# 1) Forzar HTTPS para latoma.com.ar
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:CDN-LOOP} !cloudflare
RewriteCond %{REQUEST_URI} !^/.well-known/acme-challenge/
RewriteCond %{HTTP_HOST} ^(www\.)?latoma\.com\.ar$ [NC]
RewriteRule ^(.*)$ https://latoma.com.ar/$1 [R=301,L]

# 2) Reescritura interna hacia /latoma/ (mantiene la URL en /)
RewriteCond %{HTTP_HOST} ^(www\.)?latoma\.com\.ar$ [NC]
RewriteCond %{REQUEST_URI} !^/latoma(/|$) [NC]
RewriteRule ^(.*)$ /latoma/$1 [L]
</IfModule>

# ==========================================================================
# SISE Argentina — configuración de Apache (hosting Ferozo / DonWeb)
#
# GENERADO POR scripts/generate-htaccess.mjs — no editar a mano.
# Los 301 del sitio anterior salen de app/lib/legacyRedirects.js; para
# cambiarlos, editar ese archivo y volver a compilar.
# ==========================================================================

Options -Indexes
# index.php incluido porque estas directivas se heredan en /latoma (WordPress).
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# --- 1. Un solo host y siempre por HTTPS ----------------------------------
# Sin esto el mismo contenido queda accesible en cuatro direcciones (con y
# sin www, con y sin TLS) y Google las trata como sitios distintos.
RewriteCond %{HTTP_HOST} ^(www\.)?siseargentina\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://siseargentina.com/$1 [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.siseargentina\.com$ [NC]
RewriteRule ^(.*)$ https://siseargentina.com/$1 [R=301,L]

