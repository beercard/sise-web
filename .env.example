SMTP_HOST=your-smtp-host
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SALES_EMAIL_TO=ventas@example.com
SALES_EMAIL_FROM=ventas@example.com
CONTACT_EMAIL_TO=contacto@example.com
CONTACT_EMAIL_FROM=contacto@example.com


# Vivo del home (Puente Gral. Belgrano).
# Por defecto se embebe el vivo EN CURSO del canal de SISE, asi que al cambiar
# la transmision no hay que tocar nada. Estas dos variables son opcionales:
#
#   NEXT_PUBLIC_LIVE_CHANNEL_ID  otro canal (id que empieza con UC...)
#   NEXT_PUBLIC_LIVE_VIDEO_ID    fija un video puntual en lugar del vivo;
#                                acepta el id o la URL entera de YouTube
#
# NEXT_PUBLIC_LIVE_CHANNEL_ID=UC2RkL2eATR1V6H8g4eNfA5Q
# NEXT_PUBLIC_LIVE_VIDEO_ID=
